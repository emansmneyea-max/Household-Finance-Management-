# Copy to .env and fill in real values.
# Never commit .env

# Neon (or local Postgres) used by npm run dev
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
PORT=4000

# Dedicated database for npm test — tests TRUNCATE the transactions table.
# Local Docker example (from the repo docker-compose.yml):
# TEST_DATABASE_URL=postgresql://app:app_password@localhost:5432/finance_tracker
TEST_DATABASE_URL=postgresql://app:app_password@localhost:5432/finance_tracker

JWT_SECRET=replace-with-a-long-random-secret
